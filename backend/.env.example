APP_ENV=development

# Database connection URL (PostgreSQL default)
DATABASE_URL=postgresql+psycopg://interviewer:interviewer_password@localhost:5432/ai_interviewer

# Optional SQLite fallback for immediate local testing if PostgreSQL is not active
# DATABASE_URL=sqlite:///./interviewer.db

# -----------------------------------------------------------------------------
# FREE OPTION 1: Built-in Free Heuristic AI Engine (DEFAULT, 100% Free, No API key needed)
# The system automatically parses resumes, crafts tailored questions, and evaluates
# answers even when your OpenAI credit balance is $0.00!
# -----------------------------------------------------------------------------
ENABLE_FREE_FALLBACK=True

# -----------------------------------------------------------------------------
# FREE OPTION 2: Groq Cloud (100% Free, Extremely Fast, No Credit Card Required)
# 1. Sign up at https://console.groq.com/
# 2. Create a free API key (gsk_...)
# 3. Uncomment the 3 lines below:
# -----------------------------------------------------------------------------
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=gsk_your_groq_api_key_here
# OPENAI_TEXT_MODEL=llama-3.3-70b-versatile

# -----------------------------------------------------------------------------
# FREE OPTION 3: Google Gemini API (100% Free, 1500 Requests/Day Free)
# 1. Sign up at https://aistudio.google.com/
# 2. Create a free API key (AIzaSy...)
# 3. Uncomment the 3 lines below:
# -----------------------------------------------------------------------------
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_API_KEY=AIzaSy_your_gemini_api_key_here
# OPENAI_TEXT_MODEL=gemini-1.5-flash

# -----------------------------------------------------------------------------
# OPTION 4: Paid OpenAI API (Requires paid credits at platform.openai.com)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview-2024-12-17
OPENAI_VOICE=alloy

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Maximum resume upload size in Megabytes
MAX_RESUME_SIZE_MB=10
