APP_ENV=development

# Database connection URL (PostgreSQL default)
DATABASE_URL=postgresql+psycopg://interviewer:interviewer_password@localhost:5432/ai_interviewer

# Optional SQLite fallback for immediate local testing if PostgreSQL is not active
# DATABASE_URL=sqlite:///./interviewer.db

# OpenAI API Key (Required for AI features)
OPENAI_API_KEY=

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Maximum resume upload size in Megabytes
MAX_RESUME_SIZE_MB=10

# OpenAI Models
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview-2024-12-17
OPENAI_VOICE=alloy

